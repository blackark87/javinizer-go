config_version: 3
# API authentication credentials are stored in `auth.credentials.json` next to this file.
# To reset credentials, stop the server, delete that file, then restart `javinizer web`.
#
# Setup endpoint protection (first-arriver takeover prevention):
# Set JAVINIZER_SETUP_SECRET environment variable to require a bootstrap secret
# for the /auth/setup endpoint. If not set, setup is only available from localhost.
# Example: export JAVINIZER_SETUP_SECRET="my-secret-key"
# When set, include X-Setup-Secret: my-secret-key header in the setup request.
#
# To allow setup from additional networks (e.g. Docker bridge), set
# JAVINIZER_SETUP_TRUSTED_CIDRS to a comma-separated list of CIDRs.
# Example: export JAVINIZER_SETUP_TRUSTED_CIDRS="172.16.0.0/12"
# This adds the given networks to the default loopback-only allowlist.

server:
    host: localhost
    port: 8765
api:
    security:
        # CORS allowed origins for API and WebSocket connections
        # - Specific origins only (wildcard "*" is NOT supported for security reasons)
        # - Empty array [] means same-origin only
        # - Add frontend origins if using a separate web server (e.g., "http://localhost:5173" for Vite dev server)
        allowed_origins:
            - http://localhost:8765
            - http://localhost:5173
            - http://localhost:5174
            - http://127.0.0.1:8765
            - http://127.0.0.1:5173
            - http://127.0.0.1:5174

        # Allowed directories for API file operations (organize, preview, etc.)
        # Empty list = deny-by-default until you choose a specific folder.
        # Example entries: ~/Videos, /media, /mnt/nas/movies
        allowed_directories: []

        # Explicitly deny specific directories (optional)
        denied_directories: []

        # Maximum number of files to return in a scan (0 = unlimited)
        max_files_per_scan: 0
        # Timeout for scan operations in seconds (0 = disabled)
        scan_timeout_seconds: 0

        # Rate limiting for write endpoints (per IP, requests per minute)
        # Disabled for single-user operation.
        rate_limit:
            requests_per_minute: 0

        # Trusted reverse proxy IPs/CIDRs for proxy header validation.
        # X-Forwarded-Proto, X-Forwarded-Host, and Forwarded are only used for
        # same-origin checks (and secure cookie detection) when the direct
        # client address matches this list; untrusted clients cannot spoof them.
        # Example: ["172.16.0.1", "10.0.0.0/8"] for reverse proxies
        trusted_proxies: []

        # Force Secure flag on session cookies regardless of TLS detection.
        # Use when TLS termination happens upstream and proxy IPs are dynamic.
        force_secure_cookies: false
system:
    # File creation mask (umask) for created files and directories
    # 002 = rwxrwxr-x (owner and group can write, others can read)
    # 022 = rwxr-xr-x (only owner can write, others can read)
    # Can be overridden with UMASK environment variable
    umask: "002"
    # Enable automatic version checking (notifications only, no auto-update)
    version_check_enabled: true
    # Interval between version checks in hours (default: 24)
    version_check_interval_hours: 24
    # Restrict update notifications to stable releases only (default: false).
    # When false, notifications also surface prereleases (e.g. v1.1.0-rc1) so
    # users tracking release candidates are alerted. Set to true to be
    # notified only about stable releases.
    version_check_stable_only: false
    # Base directory for temporary files (posters, etc.)
    # Can be overridden with JAVINIZER_TEMP_DIR environment variable
    temp_dir: data/temp
scrapers:
    user_agent: "" # Default: Chrome UA. r18dev uses Javinizer UA automatically.
    # Referer header for CDN compatibility (required by DMM/R18 CDN)
    referer: https://www.dmm.co.jp/
    # HTTP client timeout in seconds (default: 30)
    timeout_seconds: 30
    # Overall request timeout in seconds (default: 60)
    request_timeout_seconds: 60
    priority:
        - r18dev
        - fanzamcp
        - libredmm
        - dmm
        - javlibrary
        - javdb
        - javbus
        - jav321
        - mgstage
        - tokyohot
        - aventertainment
        - caribbeancom
        - dlgetchu
        - fc2
        - paipancon
        - 123av
        - javstash
    # NEW: Global scrape_actress default (opt-out behavior)
    scrape_actress: true
    # Stop querying lower-priority scrapers once enough successful results cover required_fields.
    early_stop: false
    early_stop_min_results: 2

    # NEW: Global Browser configuration
    browser:
        enabled: false                    # Master kill-switch (enable per-scraper below)
        binary_path: ""                   # Auto-discovered if empty
        timeout: 30                       # Operation timeout (seconds)
        headless: true                    # Run headless (hide browser window)
        stealth_mode: true                # Anti-detection measures
        window_width: 1920               # Viewport width
        window_height: 1080              # Viewport height
        slow_mo: 0                       # Slow motion (ms, for debugging)
        block_images: true               # Block images for speed
        block_css: false                 # Block CSS (may break some sites)
        user_agent: ""                   # Override UA (empty = use scraper's)
        debug_visible: false             # Show browser window for debugging
    # Global FlareSolverr config for Cloudflare bypass.
    # Per-scraper override: set flaresolverr at scraper level (e.g., scrapers.r18dev.flaresolverr).
    flaresolverr:
        enabled: false
        url: "http://localhost:8191/v1"
        timeout: 30
        session_ttl: 300
    # HTTP/SOCKS5 proxy configuration.
    # - Define reusable profiles in `profiles`
    # - Scraper uses `proxy.profile: profilename` to select a profile
    # - FlareSolverr is configured at scraper level or globally (scrapers.flaresolverr)
    proxy:
        enabled: false
        default_profile: "main"   # Global default profile when proxy is enabled
        profiles:
            main:
                url: ""           # Examples: "http://proxy.example.com:8080", "socks5://localhost:1080"
                username: ""      # Optional authentication
                password: ""      # Optional authentication
            backup:
                url: ""
                username: ""
                password: ""
    # Per-scraper proxy overrides (optional).
    # Each scraper can override with: proxy.profile, proxy.url, etc.
    # Per-scraper FlareSolverr: set flaresolverr at scraper level (not under proxy).
    r18dev:
        enabled: true
        language: en               # en | ja
        user_agent: Javinizer (+https://github.com/javinizer/javinizer-go) # Scraper-friendly source, uses Javinizer UA by default
        respect_retry_after: true    # Respect Retry-After header from server
        # rate_limit: 0             # Delay between requests in milliseconds (0 = no delay)
        # retry_count: 0            # Number of retries on failure (0 = no retries)
    # Internal metadata/media API exposed by the fanza-mcp container.
    # Enable after fanza-mcp has been deployed with /api/v1/metadata support.
    fanzamcp:
        enabled: false
        base_url: "http://fanza-mcp:8000"
        rate_limit: 0
        timeout: 30
    dmm:
        enabled: false
        use_browser: true                # Enable browser for DMM streaming pages
        # scrape_actress: null          # Optional: inherit from global (true)
        # Or override: scrape_actress: false
        user_agent: ""
        use_flaresolverr: false
    libredmm:
        enabled: false
        base_url: "https://www.libredmm.com"
    paipancon:
        enabled: true
        rate_limit: 1000
        base_url: "https://paipancon.com"
    123av:
        enabled: true
        language: ja
        rate_limit: 1000
        base_url: "https://123av.com"
    # Internal actress identity resolver. It is not shown as a movie metadata
    # provider; missing-DMM verification runs automatically even when disabled.
    sougouwiki:
        enabled: false            # Retained for config compatibility; resolver calls are automatic
        request_delay: 1000
        base_url: "https://seesaawiki.jp/w/sougouwiki/"
    mgstage:
        enabled: false            # Opt-in: requires age verification cookie (adc=1)
    # JavLibrary requires FlareSolverr for Cloudflare bypass.
    # Configure flaresolverr at scrapers.flaresolverr or at scraper level.
    javlibrary:
        enabled: false
        # Frontend scraper options:
        # language: en, ja, cn, tw
        language: ja  # Default Japanese
        # rate_limit: 1000  # Delay between requests in milliseconds (0 = no delay)
        base_url: "http://www.javlibrary.com"
        cookies:
            cf_clearance: ""
            cf_bm: ""
        user_agent: ""
        # Proxy configuration:
        # - enabled: true + profile: name  → Use specific profile
        # - enabled: true (no profile)     → Inherit global default
        # - enabled: false or omitted      → Direct (no proxy)
        # Note: Global scrapers.proxy.enabled must be true for proxy to work.
        proxy:
            enabled: false
            # profile: main  # Set enabled: true and uncomment to use proxy
        use_flaresolverr: false  # Enable to use global FlareSolverr for Cloudflare bypass
    # JavDB: configure flaresolverr at scrapers.flaresolverr or per-scraper
    javdb:
        enabled: false
        base_url: "https://javdb.com"
        # rate_limit: 1000  # Delay between requests in milliseconds (0 = no delay)
        # Example: proxy profile (flaresolverr configured globally or per-scraper)
        # proxy:
        #   enabled: true
        #   profile: main
        use_flaresolverr: false  # Enable to use global FlareSolverr for Cloudflare bypass
    javbus:
        enabled: false
        language: ja
        base_url: "https://www.javbus.com"
        # age=verified, dv=1, existmag=mag cookies are applied automatically by scraper.
        use_flaresolverr: false  # Enable to use global FlareSolverr for Cloudflare bypass
    jav321:
        enabled: false
        base_url: "https://jp.jav321.com"
    tokyohot:
        enabled: false
        language: ja
        base_url: "https://www.tokyo-hot.com"
    aventertainment:
        enabled: false
        language: en
        base_url: "https://www.aventertainments.com"
        scrape_bonus_screens: false # Append bonus image files (e.g., "特典ファイル ... (48 Pics)") to screenshot URLs
    dlgetchu:
        enabled: false
        base_url: "http://dl.getchu.com"
    caribbeancom:
        enabled: false
        language: ja
        base_url: "https://www.caribbeancom.com"
    fc2:
        enabled: false
        base_url: "https://adult.contents.fc2.com"
    javstash:
        enabled: false # Opt-in - requires API key from javstash.org
        api_key: "" # API key for authentication (or set JAVSTASH_API_KEY env var)
        base_url: "https://javstash.org/graphql"
        language: en # en | ja
metadata:
    # Per-field priorities default to inherit `scrapers.priority` (empty []).
    # A non-empty list here locks the field to those scrapers exclusively with
    # NO fallback to the global list — so it would ignore scrapers the user
    # later enables (issue #105). Leave fields empty to inherit; set a list only
    # to customize a specific field's scraper order.
    priority:
        actress: []
        content_id: []
        cover_url: []
        description: []
        director: []
        genre: []
        id: []
        label: []
        maker: []
        original_title: []
        poster_url: []
        rating: []
        release_date: []
        runtime: []
        screenshot_url: []
        series: []
        title: []
        trailer_url: []
    # Actress image database (SQLite-backed)
    actress_database:
        enabled: true
        auto_add: true        # Automatically add new actresses to database
        convert_alias: false  # Convert actress names using alias database

    # Genre replacement/normalization database (SQLite-backed)
    genre_replacement:
        enabled: true
        auto_add: true  # Automatically add new genres with identity mapping (genre -> genre)

    # Word uncensor/text replacement database (SQLite-backed)
    # Applies substring search-and-replace (longest-match-first) to all text
    # fields, including title, description, director, maker, label, series,
    # translations, and each genre token. Default censored->clean pairs (e.g.
    # S******n -> Shotacon) are seeded into the database on startup.
    # Opt-in: disabled by default since it rewrites all text fields.
    word_replacement:
        enabled: false

    # Per-movie tag database (SQLite-backed)
    # Allows adding custom tags to individual movies (appears in NFO files)
    tag_database:
        enabled: false  # Enable per-movie tag lookup (opt-in feature)

    # Local r18.dev dump lookup (SQLite-backed)
    # When the dump database is present (created by `javinizer dump download`),
    # the r18.dev scraper resolves content_ids locally instead of via
    # rate-limit-prone HTTP probing. Harmless when the file is absent.
    r18dev_dump:
        enabled: true  # Activates automatically once the dump is downloaded
        path: data/r18dev/r18dev_dump.db  # Sidecar SQLite path (relative to working dir)

    # Metadata translation pipeline
    translation:
        enabled: false                # Opt-in: disabled by default
        provider: openai              # openai | openai-compatible | anthropic | bedrock | deepl | google
        source_language: ja           # e.g., en, ja, zh, auto
        target_language: en           # e.g., en, ja, zh
        target_languages: []           # Optional list, e.g. [ko, en]; falls back to target_language when empty
        timeout_seconds: 120
        max_concurrency: 3             # Maximum concurrent LLM translation requests
        apply_to_primary: true        # Replace main metadata fields with translated text
        overwrite_existing_target: true
        dictionary_enabled: false     # false: full Korean JAV prompt; true: compact prompt + editable dictionary
        dictionary: |-
            JAV 문체 -> 성기·성행위·사정 표현은 원문의 노골성을 유지해 보지, 자지, 보빨, 대딸, 박다, 싸다처럼 직설적으로 번역. 소중이, 그곳, 중요 부위 같은 완곡어로 순화하지 않음
            문맥 원칙 -> 비성적 일반어를 억지로 음란하게 만들지 않되, 성적 중의어는 JAV 문맥을 우선
            中出し -> 질내사정(제목·장르) / 안에 싸다(거친 대사·서술)
            手コキ / ハンドジョブ / handjob -> 대딸
            ナックル手コキ -> 손가락 대딸. 너클 대딸 / 손가락 마디를 이용한 대딸처럼 직역하거나 설명하지 않음
            フェラ / フェラチオ -> 펠라(제목·장르) / 자지 빨기(거친 행위 묘사)
            クンニ / クンニリングス -> 보빨
            シックスナイン / 69 / ６９ -> 69
            素股 -> 가랑이딸
            パイパン -> 백보지
            美脚 -> 각선미
            美乳 -> 예쁜 가슴
            巨乳 -> 거유
            爆乳 -> 폭유
            美巨乳 -> 예쁜 거유. 미거유로 음차하지 않음
            ちっぱい -> 빈유(컵 크기·신체 라벨) / 작은 가슴(자연스러운 서술). 치っぱい처럼 일부만 번역하지 않음
            爆美女 -> 초미녀. 폭녀로 번역하지 않음
            桃尻 / 桃Siri -> 애플힙
            白桃尻 -> 뽀얀 애플힙
            まんこ / マンコ / おま〇こ -> 보지
            ツルツルパイパンの綺麗なマ●コ -> 매끈하고 예쁜 백보지
            チンポ / ちんぽ -> 자지
            潮吹き -> 분수 / 분수 폭발
            潮を部屋中に大噴出 -> 방 안 가득 분수 폭발
            潮吹き処女も頂いちゃった模様 -> 생애 첫 분수까지 터뜨려버린 듯
            ごっくん -> 정액 삼키기 / 정액을 삼키다. 단순 꿀꺽으로 번역하지 않음
            イラマチオ / イラマ -> 이라마치오
            オホ声 -> 거친 신음
            ちゃん / たん -> 이름 뒤의 호칭 접미사일 때 짱. 검증된 배우 활동명의 일부라면 분리하거나 의미 번역하지 않음
            にゃんこちゃん -> 야옹이짱 또는 고양이짱. 야옹이 ちゃん처럼 일본어를 남기지 않음
            ドM -> 극M
            即尺 -> 바로 펠라로 빼주기 / 바로 빨기. 삽입 행위를 추가하지 않음
            即ハメ -> 바로 박기
            手マン -> 핑거링(제목·장르) / 보지를 손가락으로 쑤시다(거친 서술)
            ガシガシ手マン -> 거친 핑거링 / 보지를 손가락으로 거칠게 쑤시다
            激ピス -> 격렬한 피스톤
            猛ピス -> 거친 피스톤 / 피스톤 맹공. 피스토닉처럼 음차하지 않음
            電クリ -> 전동 클리 자극
            電マ -> 전마
            電マ自慰 -> 전마 자위. 금지: 전마 자위(전동 마사지기 자위) / 전동 마사지기 자위 / 괄호 설명 덧붙이기
            ずぽずぽデート -> 푹푹 박는 데이트. 금지: 즈보즈로 데이트 / 즈보즈보 데이트 / 깊숙한 피스톤 데이트
            パコ撮り -> 섹스 촬영. No. 등의 뒤따르는 번호는 그대로 유지. 금지: 파코 촬영
            鬼イカセ -> 무자비 강제 절정. 연속 표현은 원문에 연속성이 있을 때만 사용
            ガン突き -> 쑤셔박기
            激イキ -> 격렬 절정
            大放出 -> 분수 대방출 / 정액 대방출. 방출 대상을 원문 문맥에서 판단
            ガン突き激イキ大放出セックス -> 쑤셔박기·격렬 절정·분수 대방출 섹스
            ハメる / ハメられる -> 박다 / 박히다
            挿れる -> 박아 넣다
            射精 -> 사정 / 싸다
            ザーメン / 精液 / 精子 -> 정액
            膣in / 膣イン -> 질 삽입. 질내사정으로 행위를 바꾸지 않음
            生挿入 -> 노콘 삽입
            生中 -> 노콘 질내사정. 생중계로 번역하지 않음
            ケツマンコ -> 후장
            アナル -> 애널
            性獣 -> 색마
            ヤリモク -> 섹스만 노리는. 야리모쿠로 음차하지 않음
            股コキ -> 가랑이딸
            太ももコキ -> 허벅지딸
            尻コキ -> 엉덩이딸
            おっパブ -> 옵파이 펍 또는 슴가 펍
            ハメ撮り -> POV 섹스 / 셀프 섹스 촬영. 일반 셀프카메라로 순화하지 않음
            ハメ撮り映像流出 -> 셀프 섹스 촬영 영상 유출. 영상 유무로 바꾸지 않음
            秘蔵 -> 미공개 또는 비공개 소장 (영상 홍보 문맥)
            蔵出し / 蔵出し動画 -> 미공개 영상 또는 소장 영상 공개
            ガルバ -> 걸즈바
            気弱 -> 소심한
            床上手 -> 섹스 고수
            レロレロ -> 레로레로
            猫じゃらし -> 고양이 장난감
            現役J● -> 현역 J●. 1인칭 J●로 번역하지 않음
            尾行押し込み -> 범죄 문맥에서 미행·주거침입. 미행 후 몰아붙이기로 번역하지 않음
            ヤリサー -> 섹스 동아리 / 섹스 서클
            おっぱいちゃん -> 성인 여성 문맥에서 거유녀 / 가슴이 큰 여자. 가슴짱으로 직역하지 않음
            ストゼロガンギマリ -> 스트롱 제로에 완전히 취한. 술을 약기운으로 바꾸지 않음
            マジ軟派、初撮。 -> 진짜 헌팅, 첫 촬영. 진짜 난파로 번역하지 않음
            連れ込みSEX隠し撮り -> 데려와 섹스 몰카
            夜の蝶 -> JAV 유흥업소 문맥에서 캬바걸 / 캬바클럽 호스티스
            キレイ系 -> 미인형. 청순한으로 의미를 바꾸지 않음
            隠れた -> 숨은 / 숨겨진. 숨겨된 같은 손상 문자열을 만들지 않음
            1年ぶり -> 1년 만의. 年 단위를 누락하지 않음
            クラスの女子が1人で -> 반 여학생이 혼자. 반 여자애들이 1명이나로 번역하지 않음
            ガチイキ -> 진짜 절정
            白ムチ -> 하얗고 통통한
            絶品 -> 최고의. 절품으로 음차하지 않음
            カメコ -> 코스프레 문맥에서 코스프레 촬영자
            嫌われた底辺カメコ -> 기피당하는 밑바닥 코스프레 촬영자
            18歳のパイパンボディ -> 18세의 백보지. 백보지 몸매처럼 부자연스럽게 늘리지 않음
            妊娠アクメ堕ち2本立SP -> 임신 절정에 빠지는 섹스 2회 SP. 2편 구성 / 2본방으로 번역하지 않음
            肛門イキ -> 애널 절정
            勃起チ○ポをいきなりアナルに突っ込まれ -> 침입 문맥에서 침입자가 발기한 자지를 갑자기 애널에 쑤셔 넣자
            2穴中出し集団痴●バス -> 2홀 질내사정 집단 치한 버스
            痴●師 -> 치한. 치녀로 성별을 바꾸지 않음
            辱める -> 성적 폭력 문맥에서 짓밟다 / 굴욕을 주다. 욕보이다는 사용하지 않음
            嫌がる女を辱め力ずくの鬼畜姦 -> 싫어하는 여자들을 짓밟고 강제로 범하는 귀축 강간
            囁き淫語 -> 속삭이는 음란어
            極妻 -> 야쿠자 아내
            アへ顔 -> 아헤가오. 생략하지 않음
            ネットでAV応募→AV体験撮影 -> 인터넷으로 AV 지원→AV 체험 촬영. 양쪽 단계와 화살표를 보존
            3P経験 -> 3P 경험. P를 누락하지 않음
            4パコ2日 -> 2일간 섹스 4회
            酔狂M -> 술에 미친 극M
            飲酒でガチギマ -> 술에 완전히 취한. 약기운을 덧붙이지 않음
            脳髄からアクメ心酔崩壊 -> 골수까지 절정에 취해 붕괴
            激シコ -> 딸감 / 꼴리는. 생략하지 않음
            タマころがし / タマ舐め -> 불알 굴리기 / 불알 핥기
            脳汁 -> 성적 쾌감 문맥에서 쾌감. 뇌수로 직역하지 않음
            3発射 -> 3회 사정
            ダーツナンパ -> 다트 헌팅. 다츠 난파 / 다트 난파로 번역하지 않음
            喉奥イマラ -> 목구멍 깊숙이 이라마치오
            ハッスルSEX -> 화끈한 섹스
            生チン / 生ちん / 生チ○ポ -> 자지. 생자지로 번역하지 않으며 生ハメ의 노콘과 구분
            ズボズボ -> 깊숙이 쑤셔박기 / 깊숙이 박히는 피스톤. 즈보즈보로 음차하지 않음
            際立たせる -> 돋보이게 하다
            七変化 -> 일곱 번 변신. 수량을 누락하지 않음
            発禁 -> 발매 금지
            全身性感帯クリトリス -> 온몸이 성감대. 전신이 성감대 클리토리스처럼 신체를 합치지 않음
            そこもっとしてして -> 거기 더 해줘
            無理無理 -> 무리야, 무리야
            ジュルジュル -> 자지를 빠는 문맥에서 쥬릅쥬릅 / 질척하게. 쥬릅쥬릅 자지를 빨아대다는 허용
            なっち -> 활동명 / 별명일 때 낫치
            みぃたん -> 활동명 / 별명일 때 미이짱
            百合川さら / ゆりかわさら -> 유리카와 사라
            久留木玲 / くるきれい -> 쿠루키 레이
            三尾めぐ / みおめぐ -> 미오 메구
            桜美ゆきな / さくらみゆきな -> 사쿠라미 유키나
            ピュアで物静かなボブJ● -> 배우 필드에서는 이름이 아닌 묘사이므로 Unknown
            激シコボディ -> 꼴리는 몸매 / 딸감 몸매
            普通に責めるの上手い -> 애무 진짜 잘하네
            シゴき上げフェラ -> 대딸하듯 훑어 올리는 펠라
            美ボディー反り返りクンニ -> 허리가 휘도록 하는 보빨
            円光 -> 조건만남
            交縁界隈 -> 길거리 조건만남 판
            立ちんぼ -> 길거리 성매매녀 / 길거리 성매매
            ホ別 + 숫자 -> 호텔비 별도 + 숫자만 엔 (예: ホ別2 -> 호텔비 별도 2만 엔)
            相場は1.5～ -> 시세는 1만 5천 엔부터
            メン地下 -> 지하남돌
            ガーシー -> 가십. 한국어 제목에서 가시로 음차하거나 원문에 없는 GaaSyy / Garsy 같은 라틴 별칭을 덧붙이지 않음
            西麻布 -> 니시아자부. 니시아부 / 니시아부파로 번역하지 않음
            デカ乳＆デカ尻のムワッ感 -> 거유와 큰 엉덩이의 짙은 색기
            シュートを決める -> 성적 JAV 문맥: 한 발 쏘다 / 실제 스포츠 문맥: 슛을 성공시키다 또는 골을 넣다
            Aにシュートを決める -> 성적 JAV 문맥: A에게 한 발 쏘다. A가 쏜 것으로 주객을 뒤집지 않음
            華麗なシュートを決めてきました -> 성적 JAV 문맥: 제대로 한 발 쏘고 왔습니다
            チームを勝利に導くマネージャーに華麗なシュートを決めてきました -> 팀을 승리로 이끄는 매니저에게 제대로 한 발 쏘고 왔습니다
            シュート -> 실제 스포츠 문맥에서만 슛. 성적 중의성이 있으면 한 발 쏘다
            小動物系 / 小動物系美少女 -> 소동물계 / 소동물계 미소녀. 의미를 작고 귀여운으로 풀어 쓰지 않음
            利き手 -> 주로 쓰는 손 (좌우를 임의로 정하지 않음)
            確変 -> 문맥에 맞게 돌변, 급격한 변화, 야함의 폭주로 의미 번역
            げんえ./き -> げんえき -> 현역
            育ち盛りHカップおっぱいちゃん -> 한창 물오른 H컵 거유녀
            鬼エグストロングファッキン -> 극강의 스트롱 퍽킹
            ずぽずぽ -> 삽입 문맥에서 푹푹 박다. 즈포즈포로 음차하지 않음
            喘ぎ声 -> 성행위 문맥에서 신음. 비명으로 번역하지 않음
            ギャラ飲み -> 유료 술자리
            美女にチンポを挿入すると自ら腰を振り -> 미녀에게 자지를 삽입하자 그녀가 스스로 허리를 흔들며. 행위 주체를 뒤집지 않음
            給料2ヶ月分の報酬に気持ちが揺らぎ -> 월급 2개월 치 보수에 마음이 흔들려
            ぐにぐにズボッ -> 말캉말캉, 쑥
            布1ミリの壁を突破 -> 천 1mm의 벽을 돌파
            義妹がロングスカート -> 의붓여동생이 롱스커트
            理性が崩壊する家庭教師のボク -> 이성이 붕괴되는 과외 선생님인 나
            厳選10人総集編付き2枚組 -> 엄선 10인 총집편 포함 2매 세트
            スローピストン -> 슬로우 피스톤
            中出しも拒めない -> 질내사정도 거부할 수 없다
            ドスケベボディギャル -> 지독하게 야한 몸매의 갸루
            少●たちを無差別に狙う -> 어린 소녀들을 무차별적으로 노린
            奇跡のカラダ -> 기적의 몸매
            性欲爆発 -> 성욕 폭발
            白目イキ怒涛絶頂3発射 -> 눈이 뒤집히며 노도 같은 절정, 3회 사정
            暴発必至 -> 참지 못하고 사정
            スケスケ＆ぱっくりエロ下着 -> 속이 비치고 보지가 훤히 드러나는 야한 속옷
            M男のち●こ全部ヌク大作戦 -> M남의 자지를 전부 빼주는 대작전
            睾丸パンパン＆ギン勃ち激アツ -> 고환 빵빵 & 빳빳하게 발기해 초대박
            ローター -> 로터 / 진동 로터. 리모트 바이브 및 리모터로 번역하지 않음
            ローターギチ詰めチャレンジ -> 로터 꽉 채우기 챌린지
            ギチ詰めローターチャレンジ -> 꽉 채우는 로터 챌린지
            浴衣の上からでもわかる -> 유카타 위로도 알 수 있는
            デカ尻に搾り取られ -> 큰 엉덩이에 쥐어짜이며
            ちびっ子水泳イントラ -> 성인 문맥에서 아담한 수영 강사. 꼬마 수영 강사로 번역하지 않음
            言葉責め -> 성행위 문맥에서 음란어 조교 / 말로 괴롭히기
            バブみ / バブみ満点 -> 모성미 / 모성미 가득
            童貞喪失3本立てSP -> 동정 탈출 3편 구성 SP
            新雪 / 新雪の様な美肌 -> 갓 내린 눈 / 갓 내린 눈처럼 하얀 피부
            パジャマdeおじゃま -> 파자마 입고 실례할게요
            即尺フェラ抜き -> 바로 펠라로 빼주기. 삽입 행위를 추가하지 않음
            【モ無】 -> 【모자이크 없음】
            FC2 제목 태그 【無】 -> 【무수정】
            オナホみたいに**てたら -> 오나홀처럼 다루다 보니. 가려진 동사를 구체적 행위로 창작하지 않음
            H柔爆乳 -> H컵 말랑 폭유
            ヤリマン男 -> 섹스광 남자
            お天気お姉さん -> 기상캐스터
            呻くように喘ぎだす -> 끙끙 앓듯 신음하기 시작한다
            必見 -> 놓치지 말 것 / 꼭 확인
            18禁 -> 18금
            1人暮らし -> 혼자 사는. 숫자 1을 별도로 출력하지 않음
            輪● -> 성폭력 문맥에서 윤간. 윤락으로 번역하지 않음
            威裸魔恥汚 -> 이라마치오
            めるてぃー -> 배우 활동명 메루티
            串刺しJ○痴● -> 꼬치처럼 꿰뚫리는 여고생 치한. 치한 2명의 수량을 한 번만 자연스러운 위치에 유지
            温泉媚薬中出し痴● -> 온천 최음제 질내사정 치한
            ナマ4発 -> 노콘 질내사정 4회
            エチエチSEX計3発射 -> 야한 섹스, 총 3회 사정
            エステ狂い -> 에스테틱 중독
            盗撮 -> 몰래 촬영 / 몰카. 도둑 촬영으로 번역하지 않음
            メンエス嬢 -> 남성 전용 에스테틱 관리사
            競泳水着 -> 경기용 수영복
            美翔女 -> 미소녀
            性癖 -> 성적 취향 / 성적 취향별. 성벽으로 번역하지 않음
            性癖射精ダービー -> 성적 취향별 사정 더비
            カウントダウンパーティー -> 카운트다운 파티
            時の静寂 -> 시간 정지 작품 문맥에서 시간의 정지
            ネットでAV応募→AV体験撮影 + 작품 번호 -> 인터넷으로 AV 지원→AV 체험 촬영 + 작품 번호. AV를 중복하거나 번호를 누락하지 않음
            まいさん -> 마이 씨
            超エロい -> 엄청 야한. 초로로 야한 같은 손상 문자열을 만들지 않음
            都月るいさ / とつきるいさ -> 토츠키 루이사
            森沢かな / もりさわかな -> 모리사와 카나
            美甘りか / みあまりか -> 미아마 리카
            有賀みなほ / ありがみなほ -> 아리가 미나호
            新村あかり / にいむらあかり -> 니이무라 아카리
        fields:
            title: true
            original_title: true
            description: true
            director: true
            maker: true
            label: true
            series: true
            genres: true
            actresses: true
        openai:
            # OpenAI-compatible endpoint (works with OpenAI, OpenRouter, and compatible providers)
            base_url: https://api.openai.com/v1
            api_key: ""               # Tip: set via OPENAI_API_KEY env var
            model: gpt-4o-mini
        deepl:
            mode: free                # free | pro (API Free/Pro plans)
            base_url: ""              # Optional override; defaults by mode
            api_key: ""               # Tip: set via DEEPL_API_KEY env var
        google:
            mode: free                # free (public endpoint) | paid (Cloud Translation API)
            base_url: ""              # Optional override
            api_key: ""               # Required for paid mode (GOOGLE_TRANSLATE_API_KEY)
        openai_compatible:
            base_url: http://localhost:11434/v1
            api_key: ""               # Optional for local/self-hosted endpoints
            model: ""
            max_output_tokens: 4096   # Caps combined thinking/reasoning and final-answer output
            enable_thinking: false    # Automatically mapped to backend-specific thinking controls when supported
            thinking_mode: boolean    # Gemma 4/boolean-only backends: boolean; reasoning-effort models only: low | medium | high
        anthropic:
            base_url: https://api.anthropic.com
            api_key: ""               # Required when provider=anthropic (set via ANTHROPIC_API_KEY env var)
            model: claude-sonnet-4-20250514
        bedrock:
            region: us-east-1
            base_url: ""              # Optional endpoint override
            access_key_id: ""         # Tip: set via AWS_ACCESS_KEY_ID env var
            secret_access_key: ""     # Tip: set via AWS_SECRET_ACCESS_KEY env var
            session_token: ""         # Optional; set via AWS_SESSION_TOKEN env var
            model: anthropic.claude-3-5-sonnet-20241022-v2:0

    # Genres to ignore/filter out. Supports both exact strings and regex patterns.
    # Patterns starting with ^, ending with $, or containing regex metacharacters are treated as regex.
    # Examples:
    #   - "Sample"           # Exact match
    #   - "^Featured"        # Starts with "Featured"
    #   - ".*mosaic.*"       # Contains "mosaic"
    #   - "^(HD|4K|VR)"      # Starts with HD, 4K, or VR
    #   - "(?i)uncensored"   # Case-insensitive match for "uncensored"
    ignore_genres: []
    # ignore_genres:
    #   - "^Featured Actress"
    #   - ".*mosaic.*"
    #   - "Sample"
    #   - "Trailer"
    required_fields: []
    nfo:
        enabled: true
        display_title: <TITLE>
        filename_template: <ID>.nfo
        first_name_order: true
        actress_language_ja: false
        per_file: false            # Generate one NFO per multi-part file when true
        # Unknown actress behavior:
        #   skip (default) - omit unknown actresses entirely
        #   fallback - use unknown_actress_text as placeholder when no actress found
        unknown_actress_mode: skip
        unknown_actress_text: Unknown
        actress_as_tag: false
        add_generic_role: false  # Add generic "Actress" role to all actresses
        alt_name_role: false     # Use alternate name (Japanese) in role field
        include_originalpath: false  # Include source filename in NFO
        include_stream_details: false
        include_fanart: true
        include_trailer: true
        rating_source: r18dev
        tag: []
        tagline: ""
        credits: []
file_matching:
    extensions:
        - .mp4
        - .mkv
        - .avi
        - .wmv
        - .flv
    min_size_mb: 0
    exclude_patterns:
        - '*-trailer*'
        - '*-sample*'
    regex_enabled: false
    regex_pattern: ([a-zA-Z|tT28]+-\d+[zZ]?[eE]?)(?:-pt)?(\d{1,2})?
output:
    folder_format: <ID> [<STUDIO>] - <TITLE> (<YEAR>)
    # Multi-language template tags (for translated metadata):
    #   <TITLE:EN>      - English title translation
    #   <TITLE:JA>      - Japanese title translation
    #   <TITLE:JA|EN>   - Japanese with English fallback
    #   <MAKER:JA>      - Japanese maker name
    #   Supported tags: TITLE, MAKER, LABEL, SERIES, DIRECTOR, DESCRIPTION, ORIGINALTITLE, STUDIO
    # Example: <ID> [<MAKER:JA>] - <TITLE:EN> (<YEAR>)
    # File format supports multi-part templates:
    #   - <PART> or <DISC>: Part number (1, 2, 3...), use <PART:2> for zero-padding (01, 02, 03...)
    #   - <PARTSUFFIX>: Original suffix from filename (e.g., "-pt1", "-A", "-cd2")
    #   - <IF:MULTIPART>...</IF>: Conditional block for multi-part files only
    # Examples:
    #   <ID><PARTSUFFIX>           → IPX-535-pt1 (preserves original suffix style)
    #   <ID>-pt<PART>              → IPX-535-pt1 (custom suffix format)
    #   <ID>-CD<PART:2>            → IPX-535-CD01 (zero-padded disc number)
    #   <ID><IF:MULTIPART>-pt<PART></IF>  → IPX-535-pt1 (only for multi-part, IPX-535 for single)
    file_format: <ID><IF:MULTIPART>-pt<PART></IF>
    subfolder_format:
        - <ID>
    # Delimiter between actress names when joining <ACTORS>/<ACTRESSES> (default: ", ").
    # Can be overridden per-tag with the DELIM= modifier, e.g.
    #   <ACTORS:DELIM=|>           -> join with |
    #   <ACTORS:DELIM= & >         -> join with " & "
    #   <ACTORS:JA,DELIM=|>        -> Japanese names joined by |
    #   <ACTORS:FIRST,DELIM=|>     -> First Last joined by |
    actress_delimiter: ', '
    max_title_length: 100
    max_path_length: 240
    # Max height in pixels for cropped posters. 0 = no cap (preserve source resolution).
    # When a cropped poster exceeds this height, it is downscaled preserving aspect ratio.
    max_poster_height: 0
    move_subtitles: false
    subtitle_extensions:
        - .srt
        - .ass
        - .ssa
        - .smi
        - .vtt
    rename_folder_in_place: false
    # Move files instead of copying (default: false / copy). Persisted by the TUI Settings toggle.
    move_files: false
    rename_file: true
    allow_revert: false
    group_actress: false
    # Folder name when group_actress is enabled and multiple actresses are found (default: "@Group")
    # group_actress_name: "@Group"
    # Replacement when group_actress is enabled and the actress list is empty or
    # contains only an unknown actress (default: "@Unknown"; mirrors original
    # Javinizer behavior)
    # group_unknown_actress_name: "@Unknown"
    # Actress name ordering in templates: true = FirstName LastName, false = LastName FirstName (default: false)
    # first_name_order: false
    # Actress name language: true = prefer Japanese name (e.g. 桜空もも) for <ACTORS>/<ACTRESS>
    # in folder/file naming when available; false = use First/Last name (default: false).
    # A tag-level modifier overrides this per-tag, e.g. <ACTORS:JA> forces Japanese,
    # <ACTORS:EN> forces English. JA|EN fallback chains are also supported.
    # Tag-level name-order modifiers override first_name_order per-tag:
    #   <ACTORS:FIRST> or <ACTORS:FIRSTNAMEORDER> -> First Last
    #   <ACTORS:LAST>  or <ACTORS:LASTNAMEORDER>  -> Last First
    # Combining with language is supported via a comma, e.g.
    # <ACTORS:EN,FIRST> forces English + First Last regardless of config defaults.
    # actress_language_ja: false
    # Media file naming templates (support placeholders like <ID>, <TITLE>, <INDEX>, etc.)
    poster_format: <ID><IF:MULTIPART>-pt<PART></IF>-poster.jpg    # Vertical poster image (e.g., IPX-535-poster.jpg, IPX-535-pt1-poster.jpg)
    fanart_format: <ID><IF:MULTIPART>-pt<PART></IF>-fanart.jpg    # Horizontal cover/background image (e.g., IPX-535-fanart.jpg, IPX-535-pt1-fanart.jpg)
    trailer_format: <ID>-trailer.mp4            # Trailer video file
    screenshot_format: fanart<INDEX>.jpg        # Screenshots in extrafanart folder (e.g., fanart1.jpg, fanart2.jpg)
                                                 # Use <INDEX:2> for zero-padded numbers (fanart01.jpg, fanart02.jpg)
    screenshot_folder: extrafanart              # Subfolder for storing screenshots
    screenshot_padding: 1                       # Zero-padding for fallback numbering (ignored if <INDEX> in template)
    actress_folder: .actors                     # Subfolder for storing actress images
    actress_format: <ACTORNAME>.jpg             # Actress image naming (e.g., Momo Sakura.jpg)
    # Download toggles for each media type
    download_cover: true                        # Download horizontal cover/fanart image
    download_poster: true                       # Download vertical poster image
    download_extrafanart: true                  # Download screenshots to extrafanart folder
    download_trailer: true
    download_actress: true
    download_timeout: 60
    # Download proxy override (optional):
    # - If disabled, downloads use scrapers.proxy automatically when scraper proxy is enabled.
    # - Enable only when you need a separate proxy just for downloads.
    download_proxy:
        enabled: false
        profile: ""  # Optional: select a different named profile than scrapers.proxy.default_profile
database:
    type: sqlite
    dsn: data/javinizer.db
    log_level: silent
logging:
    level: info
    format: text
    # stdout, stderr, /path/to/file.log, or comma-separated (e.g. "stdout,data/logs/javinizer.log")
    # Default: dual output to console and file for persistence
    # NOTE: JAVINIZER_LOG_DIR only rewrites file targets listed here.
    # If output is only stdout/stderr, JAVINIZER_LOG_DIR has no effect.
    # Docker: JAVINIZER_LOG_DIR=/javinizer/logs rewrites file path to /javinizer/logs/javinizer.log
    output: "stdout,data/logs/javinizer.log"
    # Log rotation settings (applies to file outputs only)
    max_size_mb: 10       # Max size in MB before rotation (0 = disabled)
    max_backups: 5        # Max number of old log files to keep (0 = unlimited)
    max_age_days: 0       # Max age in days to keep log files (0 = no limit)
    compress: true        # Compress rotated files (.gz)
performance:
    max_workers: 5
    worker_timeout: 300
    buffer_size: 100
    update_interval: 100

# MediaInfo configuration for video metadata extraction
mediainfo:
    # Enable MediaInfo CLI fallback for unsupported formats (WMV, ASF, exotic containers)
    # Requires 'mediainfo' binary installed on system (https://mediaarea.net/MediaInfo)
    # Native Go parsers handle: MP4, MOV, MKV, AVI, FLV
    cli_enabled: false

    # Path to mediainfo binary (default: searches system PATH)
    # Examples: "mediainfo", "/usr/local/bin/mediainfo", "C:\\Program Files\\MediaInfo\\MediaInfo.exe"
    cli_path: "mediainfo"

    # Timeout for CLI execution in seconds (default: 30)
    cli_timeout: 30

# Web UI configuration
webui:
    # Default view mode for the review page
    # Options: detail, grid-poster, grid-cover
    # Default: grid-poster
    default_review_view: grid-poster
